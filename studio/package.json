{
  "name": "farouqk-electrical",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "build": "node --env-file=../.env.local ./node_modules/.bin/sanity build",
    "deploy": "node --env-file=../.env.local ./node_modules/.bin/sanity deploy",
    "deploy-graphql": "node --env-file=../.env.local ./node_modules/.bin/sanity graphql deploy",
    "dev": "node --env-file=../.env.local ./node_modules/.bin/sanity dev",
    "start": "node --env-file=../.env.local ./node_modules/.bin/sanity start"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/vision": "^6.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sanity": "^6.2.0",
    "styled-components": "^6.1.18"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^6.0.0",
    "@types/react": "^19.2.14",
    "eslint": "^9.28",
    "prettier": "^3.5",
    "typescript": "^5.8"
  },
  "prettier": {
    "bracketSpacing": false,
    "printWidth": 100,
    "semi": false,
    "singleQuote": true
  }
}
